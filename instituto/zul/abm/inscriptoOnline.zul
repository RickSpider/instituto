<?page title="InscriptosOnline" contentType="text/html;charset=UTF-8"?>
<zk>
	<window title="InscriptoOnline" border="normal"
		viewModel="@id('vm') @init('com.instituto.sistema.abm.InscriptoOnlineVM')"
		vflex="1" id="Body" apply="org.zkoss.bind.BindComposer">

	<hlayout>
		<tablelayout columns="5">

			<tablechildren>
				<label value="Desde:" style="font-weight:bold" />
			</tablechildren>
			<tablechildren>
				<datebox value="@bind(vm.desde)"
					format="dd/MM/yyyy HH:mm:ss"
					onChange="@command('onChangeFiltroFechas')" width="150px" />
			</tablechildren>

			<tablechildren>
				<label value="Hasta:" style="font-weight:bold" />
			</tablechildren>
			<tablechildren>
				<datebox value="@bind(vm.hasta)"
					format="dd/MM/yyyy HH:mm:ss"
					onChange="@command('onChangeFiltroFechas')" width="150px" />
			</tablechildren>

			<tablechildren>
				<toolbarbutton image="/doxacore/img/icoExcel22x20.png"
					tooltiptext="Exportar a Excel" onClick="@command('exportarExcel')" />

			</tablechildren>
			
		</tablelayout>
			
		</hlayout>

		

		<hlayout vflex="1">

			<vlayout hflex="1" vflex="1">

				<!-- <hbox pack="end" hflex="1" >
					
					<button label="Agregar"
					iconSclass=" z-icon-plus" onClick="@command('modalInscriptoOnlineAgregar')" disabled="@load(!vm.opCrearInscriptoOnline)" />
					
					</hbox> -->

				<listbox emptyMessage="lista vacía..." mold="paging"
					autopaging="true" vflex="1" model="@load(vm.lInscriptosOnline)"
					checkmark="true">

					<listhead>

						<listheader hflex="min" align="center" />
						<listheader label="ID" align="right"
							hflex="min" />
						<listheader label="Curso" hflex="min" />
						<listheader label="Dia" hflex="min" />
						<listheader label="FechaInscripcion" hflex="min"
							align="left" />
						<listheader label="Nombre Completo" align="left"
							hflex="min" />
						<listheader label="CI" align="left" hflex="min" />
						<listheader label="RUC" align="left"
							hflex="min" />
						<listheader label="Razon Social" align="left"
							hflex="min" />
						<listheader label="Fact. otro" align="left"
							hflex="min" />
						<listheader label="Telefono" align="left"
							hflex="min" />
						<listheader label="Email" hflex="min"
							align="left" />
						<listheader label="Titulo" hflex="min"
							align="left" />
						<listheader label="Verificado" hflex='min' />
						<listheader label="Pago Matricula" hflex='min' />
						<listheader label="Encuesta" hflex='min' />

						<listheader hflex="min" />


					</listhead>


					<auxhead>

						<auxheader />
						<auxheader />
						<auxheader>
							<textbox value="@bind(vm.filtroColumns[1])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[2])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>


						<auxheader>
							<textbox value="@bind(vm.filtroColumns[3])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[4])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[5])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[6])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[7])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[8])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[9])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[10])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[11])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[12])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
							
						</auxheader>
						
						<auxheader>
							<textbox value="@bind(vm.filtroColumns[13])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>
						
						<auxheader>
							<textbox value="@bind(vm.filtroColumns[14])"
								instant="true" onChange="@command('filtrarInscriptoOnline')"
								hflex="1" />
						</auxheader>

						<auxheader />


					</auxhead>

					<template name="model">

						<listitem>
							<listcell />
							<listcell label="@load(each[0])" />
							<listcell label="@load(each[1])" />
							<listcell label="@load(each[2])" />
							<listcell label="@load(each[3])" />
							<listcell label="@load(each[4])" />
							<listcell label="@load(each[5])" />
							<listcell label="@load(each[6])" />
							<listcell label="@load(each[7])" />
							<listcell label="@load(each[8])" />
							<listcell label="@load(each[9])" />
							<listcell label="@load(each[10])" />
							<listcell label="@load(each[11])" />
							<listcell label="@load(each[12])" />
							<listcell label="@load(each[13])" />
							<listcell label="@load(each[14])" />

							<listcell>
								<hlayout>

									<button iconSclass="z-icon-edit"
										onClick="@command('modalInscriptoOnline', inscriptoOnlineid=each[0])"
										tooltiptext="Editar"
										disabled="@load(!vm.opEditarInscriptoOnline)" />

									<button iconSclass="z-icon-trash-o"
										style="background-color:red"
										onClick="@command('borrarInscriptoOnlineConfirmacion', inscriptoOnlineid=each[0])"
										tooltiptext="Borrar"
										disabled="@load(!vm.opBorrarInscriptoOnline)" />


								</hlayout>


							</listcell>


						</listitem>


					</template>

					<listfoot>
						<listfooter span="15" align="left">
							<hlayout>
								<label
									value="@load(vm.lInscriptosOnline.size())" />
								<label value="items" />
							</hlayout>
						</listfooter>
					</listfoot>


				</listbox>

			</vlayout>



		</hlayout>

	</window>
</zk>