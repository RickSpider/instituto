<?page title="Nota de Credito" contentType="text/html;charset=UTF-8"?>
<zk>
	<window title="Notacds" border="normal"
		viewModel="@id('vm') @init('com.instituto.sistema.administracion.NotaCreditoVM')"
		vflex="1" id="Body" apply="org.zkoss.bind.BindComposer">

		<hlayout vflex="1">

			<vlayout hflex="1" vflex="1">
			
			<hbox pack="end" hflex="1" >

				<button label="Agregar"
						iconSclass=" z-icon-plus" onClick="@command('modalNotacdAgregar')" disabled="@load(!vm.opCrearNotacd)" />

			</hbox>
			

				<listbox emptyMessage="lista vacía..." mold="paging" autopaging="true"
					vflex="1" model="@load(vm.lNotacds)" checkmark="true">

					<listhead>

						<listheader hflex="min" align="center" />
						<listheader label="ID" align="right"
							hflex="min" />

						<listheader label="Fecha" align="center" hflex="min"/>
						<listheader label="Timbrado" align="center" hflex="min"/>
						<listheader label="Comprobante #" align="center" hflex="min"/>
						<listheader label="RUC" width="250px" align="center" hflex="min"/>
						<listheader label="Razón Social" align="center" />
						<listheader label="Anulado" align="center" />
						<listheader label="Fecha de Anulacion" align="center" />
						
							
						<listheader align="center" hflex="min" />


					</listhead>


					<auxhead>

						<auxheader />
						<auxheader />

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[1])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[2])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[3])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[4])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>

						<auxheader>
							<textbox value="@bind(vm.filtroColumns[5])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>
						
							<auxheader>
							<textbox value="@bind(vm.filtroColumns[6])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>
						
							<auxheader>
							<textbox value="@bind(vm.filtroColumns[7])"
								instant="true" onChange="@command('filtrarCobranzas')"
								hflex="1" />
						</auxheader>
					

						<auxheader />

					</auxhead>

					<template name="model">

						<listitem>
							<listcell />
							<listcell label="@load(each[0])" style="text-align: right;"/>
							<listcell label="@load(each[1])" />
							<listcell label="@load(each[2])" />
							<listcell label="@load(each[3])" />
							<listcell label="@load(each[4])" />
							<listcell label="@load(each[5])" />
							<listcell label="@load(each[6])" />
							<listcell label="@load(each[7])" />

							
							<listcell>
								<hlayout>
								
									

									<button iconSclass="z-icon-print"
										class="doxa-button-green"
										onClick="@command('verComprobante', dato=each)"
										tooltiptext="Imprimir Comprobante" /> 
										
								<!-- 	<button iconSclass="z-icon-envelope "
										class="doxa-button-orange"
										onClick="@command('enviaremailFEConfirmacion', cobranzaid=each[0])"
										tooltiptext="Enviar comprobante por mail" />  -->

								 	<button iconSclass="z-icon-unlink "
										class="doxa-button-red"
										onClick="@command('anularNotaCreditoConfirmacion', id=each[0])"
										tooltiptext="Anular"  />  


								</hlayout>


							</listcell>


						</listitem>


					</template>

					<listfoot>
						<listfooter span="4" align="left">
							<hlayout>
								<label
									value="@load(vm.lNotacds.size())" />
								<label value="items" />
							</hlayout>
						</listfooter>
					</listfoot>


				</listbox>

			</vlayout>



		</hlayout>

	</window>
</zk>